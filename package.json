{
  "name": "@ansvar/polish-law-mcp",
  "version": "2.0.0",
  "mcpName": "eu.ansvar/polish-law-mcp",
  "description": "Complete Polish law database — 8,943 Acts (Ustawy), 944,498 provisions (article + ustęp/punkt/litera/§ granularity) from the Sejm ELI API covering all parliamentary legislation published in Dziennik Ustaw (1918-2026) with Polish full-text search, status-aware reranking, and EU cross-references. Database shipped separately; point POLISH_LAW_DB_PATH at it.",
  "author": "Ansvar Systems <hello@ansvar.eu>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ansvar-Systems/polish-law-mcp.git"
  },
  "homepage": "https://ansvar.eu",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "polish-law",
    "rodo",
    "gdpr",
    "uodo",
    "data-protection",
    "cybersecurity",
    "ksc",
    "cybercrime",
    "kodeks-karny",
    "ksh",
    "legislation",
    "legal",
    "compliance",
    "isap",
    "ansvar"
  ],
  "type": "module",
  "main": "dist/src/index.js",
  "bin": {
    "polish-law-mcp": "dist/src/index.js"
  },
  "files": [
    "dist",
    "server.json"
  ],
  "scripts": {
    "build": "tsc",
    "build:db": "node --import tsx scripts/build-db.ts",
    "dev": "node --import tsx src/index.ts",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "census": "node --import tsx scripts/census.ts",
    "ingest": "node --import tsx scripts/ingest.ts",
    "ingest:pdf": "node --import tsx scripts/ingest-pdf.ts",
    "ingest:regulations": "node --import tsx scripts/ingest-regulations.ts",
    "test:contract": "vitest run --passWithNoTests __tests__/contract/",
    "drift:detect": "node --import tsx scripts/drift-detect.ts",
    "validate": "npm run lint && npm test && npm run test:contract",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "postinstall": "test -d dist || npm run build || true",
    "check-updates": "node --import tsx scripts/check-updates.ts"
  },
  "dependencies": {
    "@ansvar/mcp-sqlite": "^1.0.3",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.4.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.29",
    "@vercel/node": "^5.6.4",
    "better-sqlite3": "^12.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "path-to-regexp": "^8.0.0",
    "undici": "^7.0.0",
    "ajv": "^8.18.0"
  }
}
