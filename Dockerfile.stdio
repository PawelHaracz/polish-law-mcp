# stdio transport image for Docker MCP Gateway.
# Builds the SQLite DB from data/seed/ inside the image (reproducible),
# then ships only dist/ + the compiled database.db on a non-root user.

# ── Stage 1: Build (deps, tsc, DB) ──────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app

# Toolchain for better-sqlite3 native build (used only by the DB builder).
RUN apk add --no-cache python3 make g++

COPY package*.json ./
# Full install incl. devDeps; run scripts so better-sqlite3 compiles.
RUN npm ci

COPY tsconfig.json ./
COPY src ./src
COPY scripts ./scripts
RUN npm run build

# Build the SQLite DB from seed JSON (writes data/database.db).
COPY data/seed ./data/seed
RUN npm run build:db

# ── Stage 2: Production ─────────────────────────────────────────────────
FROM node:20-alpine AS production
WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev --ignore-scripts

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/data/database.db ./data/database.db

# Security: non-root user. /tmp must be writable for ensure-readable-db.
RUN addgroup -S nodejs && adduser -S nodejs -G nodejs \
 && chown -R nodejs:nodejs /app
USER nodejs

ENV NODE_ENV=production
# Absolute DB path — index.js lives at dist/src/, so its relative resolution
# would point at dist/data/. Pin it to the real location instead.
ENV POLISH_LAW_DB_PATH=/app/data/database.db
# stdio entry point — gateway speaks MCP over stdio.
# tsc roots at the common parent of src/+scripts/, so output lands under dist/src/.
CMD ["node", "dist/src/index.js"]
