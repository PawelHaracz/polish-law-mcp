# stdio transport image for Docker MCP Gateway.
# Ships the prebuilt data/database.db (see `npm run build:db` to regenerate it
# from data/seed/ on the host) plus dist/, on a non-root user.

# ── Stage 1: Build (deps, tsc) ──────────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app

COPY package*.json ./
RUN npm ci --ignore-scripts

COPY tsconfig.json ./
COPY src ./src
COPY scripts ./scripts
RUN npm run build

# ── Stage 2: Production ─────────────────────────────────────────────────
FROM node:20-alpine AS production
WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev --ignore-scripts

COPY --from=builder /app/dist ./dist
# Prebuilt on the host — data/seed is excluded by .dockerignore.
COPY data/database.db ./data/database.db

# Security: non-root user. /tmp must be writable for ensure-readable-db.
RUN addgroup -S nodejs && adduser -S nodejs -G nodejs \
 && chown -R nodejs:nodejs /app
USER nodejs

ENV NODE_ENV=production
# Absolute DB path — index.js lives at dist/src/, so its relative resolution
# would point at dist/data/. Pin it to the real location instead.
ENV POLISH_LAW_DB_PATH=/app/data/database.db
# stdio entry point — gateway speaks MCP over stdio.
# tsc roots at the common parent of src/+scripts/, so output lands under dist/src/.
CMD ["node", "dist/src/index.js"]
