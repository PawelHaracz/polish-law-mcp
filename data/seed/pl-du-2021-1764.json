  "provisions": [
    {
      "provision_ref": "par1",
      "section": "1",
      "title": "§ 1",
      "content": "W rozporządzeniu Ministra Zdrowia z dnia 22 listopada 2013 r. w sprawie świadczeń gwarantowanych z zakresu leczenia szpitalnego w § 10a wyrazy „30 września 2021 r.” zastępuje się wyrazami „31 grudnia 2021 r.” ."
    },
    {
      "provision_ref": "par2",
      "section": "2",
      "title": "§ 2",
      "content": "Rozporządzenie wchodzi w życie z dniem 30 września 2021 r."
    }
