  "provisions": [
    {
      "provision_ref": "par1",
      "section": "1",
      "title": "§ 1",
      "content": "W rozporządzeniu Ministra Administracji i Cyfryzacji z dnia 16 września 2015 r. w sprawie udzielania pomocy na rozwój infrastruktury szerokopasmowej w ramach Programu Operacyjnego Polska Cyfrowa na lata 2014-2020 w § 8 uchyla się ust. 5."
    },
    {
      "provision_ref": "par2",
      "section": "2",
      "title": "§ 2",
      "content": "Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia."
    }
  ],
