{
  "id": "pl-du-2023-354",
  "type": "statute",
  "title": "Rozporządzenie Ministra Zdrowia z dnia 23 lutego 2023 r. w sprawie zakażeń wirusem syncytialnym układu oddechowego (RSV)",
  "title_en": "",
  "short_name": "pl-du-2023-354",
  "status": "in_force",
  "issued_date": "2023-02-23",
  "in_force_date": "2023-02-24",
  "url": "https://api.sejm.gov.pl/eli/acts/DU/2023/354",
  "provisions": [
    {
      "provision_ref": "par1",
      "section": "1",
      "title": "§ 1",
      "content": "Ogłasza się, że zakażenia wirusem syncytialnym układu oddechowego (RSV) zostały objęte przepisami o zapobieganiu oraz zwalczaniu zakażeń i chorób zakaźnych u ludzi."
    },
    {
      "provision_ref": "par2",
      "section": "2",
      "title": "§ 2",
      "content": "Rozporządzenie wchodzi w życie z dniem następującym po dniu ogłoszenia."
    }
  ],
