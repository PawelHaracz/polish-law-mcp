{
  "id": "pl-du-2025-1462",
  "type": "statute",
  "title": "Rozporządzenie Ministra Obrony Narodowej z dnia 16 października 2025 r. w sprawie określenia priorytetowych dziedzin medycyny dla Sił Zbrojnych Rzeczypospolitej Polskiej",
  "title_en": "",
  "short_name": "pl-du-2025-1462",
  "status": "in_force",
