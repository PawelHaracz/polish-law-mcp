{
  "id": "pl-du-2019-1685",
  "type": "statute",
  "title": "Rozporządzenie Ministra Finansów z dnia 26 lipca 2019 r. w sprawie zmiany obszaru wolnego obszaru celnego w Gdańsku",
  "title_en": "",
  "short_name": "pl-du-2019-1685",
  "status": "in_force",
  "issued_date": "2019-07-26",
  "in_force_date": "2019-09-03",
  "url": "https://api.sejm.gov.pl/eli/acts/DU/2019/1685",
  "provisions": [
    {
      "provision_ref": "par1",
      "section": "1",
      "title": "§ 1",
      "content": "Określa się, w załączniku do rozporządzenia, granice i obszar wolnego obszaru celnego w Gdańsku, ustanowionego rozporządzeniem Rady Ministrów z dnia 28 listopada 1995 r. w sprawie ustanowienia wolnego obszaru celnego w Gdańsku ."
    },
    {
      "provision_ref": "par2",
      "section": "2",
      "title": "§ 2",
      "content": "Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia."
    }
  ],
