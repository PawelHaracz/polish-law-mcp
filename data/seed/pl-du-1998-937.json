{
  "id": "pl-du-1998-937",
  "type": "statute",
  "title": "Ustawa z dnia 30 września 1998 r. o przedłużeniu kadencji ławników ludowych i członków kolegiów do spraw wykroczeń.",
  "title_en": "",
  "short_name": "pl-du-1998-937",
  "status": "repealed",
  "issued_date": "1998-09-30",
  "in_force_date": "1998-12-02",
  "url": "https://api.sejm.gov.pl/eli/acts/DU/1998/937",
  "provisions": [
    {
      "provision_ref": "art1",
      "section": "1",
      "title": "Art. 1",
      "content": "Przedłuża się kadencję ławników ludowych w sądach powszechnych, wybranych na kadencję obejmującą lata 1994-1998, do których stosuje się przepisy ustawy z dnia 20 czerwca 1985 r. - Prawo o ustroju sądów powszechnych , do dnia 31 grudnia 1999 r."
    },
    {
      "provision_ref": "art2",
      "section": "2",
      "title": "Art. 2",
      "content": "Przedłuża się kadencję członków kolegiów do spraw wykroczeń, wybranych na kadencję obejmującą lata 1994-1998, do których stosuje się przepisy ustawy z dnia 20 maja 1971 r. o ustroju kolegiów do spraw wykroczeń , do dnia 31 grudnia 1999 r."
    },
    {
      "provision_ref": "art3",
      "section": "3",
      "title": "Art. 3",
      "content": "Ustawa wchodzi w życie z dniem ogłoszenia."
    }
  ],
