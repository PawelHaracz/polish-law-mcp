{
  "id": "pl-du-1991-514",
  "type": "statute",
  "title": "Ustawa z dnia 18 października 1991 r. o zmianie Konstytucji Rzeczypospolitej Polskiej.",
  "title_en": "",
  "short_name": "pl-du-1991-514",
  "status": "in_force",
  "issued_date": "1991-10-18",
  "in_force_date": "1991-12-20",
  "url": "https://api.sejm.gov.pl/eli/acts/DU/1991/514",
  "provisions": [
    {
      "provision_ref": "art1",
      "section": "1",
      "title": "Art. 1",
      "content": "W Konstytucji Rzeczypospolitej Polskiej art. 88 otrzymuje brzmienie: „ Obywatele innych państw i bezpaństwowcy mogą korzystać z prawa azylu na zasadach określonych ustawą. ”"
    },
    {
      "provision_ref": "art2",
      "section": "2",
      "title": "Art. 2",
      "content": "Ustawa wchodzi w życie po upływie 14 dni od dnia ogłoszenia."
    }
  ],
