{
  "id": "pl-du-2022-1143",
  "type": "statute",
  "title": "Rozporządzenie Ministra Zdrowia z dnia 27 maja 2022 r. w sprawie ospy małpiej oraz zakażeń wirusem ospy małpiej",
  "title_en": "",
  "short_name": "pl-du-2022-1143",
  "status": "in_force",
  "issued_date": "2022-05-27",
  "in_force_date": "2022-05-30",
  "url": "https://api.sejm.gov.pl/eli/acts/DU/2022/1143",
  "provisions": [
    {
      "provision_ref": "par1",
      "section": "1",
      "title": "§ 1",
      "content": "Ogłasza się, że ospa małpia oraz zakażenia wirusem ospy małpiej zostały objęte przepisami o zapobieganiu oraz zwalczaniu zakażeń i chorób zakaźnych u ludzi."
    },
    {
      "provision_ref": "par2",
      "section": "2",
      "title": "§ 2",
      "content": "Rozporządzenie wchodzi w życie z dniem następującym po dniu ogłoszenia."
    }
  ],
