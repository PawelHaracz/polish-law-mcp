{
  "id": "pl-du-2023-1600",
  "type": "statute",
  "title": "Rozporządzenie Ministra Spraw Wewnętrznych i Administracji z dnia 7 sierpnia 2023 r. zmieniające rozporządzenie w sprawie stawek uposażenia zasadniczego funkcjonariuszy Służby Ochrony Państwa",
  "title_en": "",
  "short_name": "pl-du-2023-1600",
  "status": "in_force",
  "issued_date": "2023-08-07",
  "in_force_date": "2023-08-11",
  "url": "https://api.sejm.gov.pl/eli/acts/DU/2023/1600",
  "provisions": [
    {
      "provision_ref": "par1",
      "section": "1",
      "title": "§ 1",
      "content": "W rozporządzeniu Ministra Spraw Wewnętrznych i Administracji z dnia 6 lutego 2018 r. w sprawie stawek uposażenia zasadniczego funkcjonariuszy Służby Ochrony Państwa załącznik nr 2 do rozporządzenia otrzymuje brzmienie określone w załączniku do niniejszego rozporządzenia."
    },
    {
      "provision_ref": "par2",
      "section": "2",
      "title": "§ 2",
      "content": "Rozporządzenie wchodzi w życie po upływie 7 dni od dnia ogłoszenia."
    }
  ],
