{
  "id": "pl-du-2002-1524",
  "type": "statute",
  "title": "Ustawa z dnia 13 września 2002 r. o zmianie ustawy - Prawo o ruchu drogowym.",
  "title_en": "",
  "short_name": "pl-du-2002-1524",
  "status": "amended",
  "issued_date": "2002-09-13",
  "in_force_date": "2002-11-05",
  "url": "https://api.sejm.gov.pl/eli/acts/DU/2002/1524",
  "provisions": [
    {
      "provision_ref": "art1",
      "section": "1",
      "title": "Art. 1",
      "content": "W ustawie z dnia 20 czerwca 1997 r. - Prawo o ruchu drogowym w art. 79 w ust. 4 w pkt 3 kropkę zastępuje się przecinkiem i dodaje się pkt 4 w brzmieniu: „ ciągnika i przyczepy rolniczej. ” ."
    },
    {
      "provision_ref": "art2",
      "section": "2",
      "title": "Art. 2",
      "content": "Ustawa wchodzi w życie po upływie 14 dni od dnia ogłoszenia."
    }
  ],
