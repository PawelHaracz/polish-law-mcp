  "provisions": [
    {
      "provision_ref": "art1",
      "section": "1",
      "title": "Art. 1",
      "content": "W ustawie z dnia 5 stycznia 1991 r. - Prawo budżetowe dodaje się art. 76 w brzmieniu: „ Do czasu utworzenia, na podstawie odrębnej ustawy, regionalnych izb obrachunkowych zadania tych izb, określone w ustawie z dnia 8 marca 1990 r. o samorządzie terytorialnym , wykonują wojewodowie. ”"
    },
    {
      "provision_ref": "art2",
      "section": "2",
      "title": "Art. 2",
      "content": "Ustawa wchodzi w życie z dniem ogłoszenia."
    }
  ],
