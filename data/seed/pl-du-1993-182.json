  "in_force_date": "1993-05-19",
  "url": "https://api.sejm.gov.pl/eli/acts/DU/1993/182",
  "provisions": [
    {
      "provision_ref": "art1",
      "section": "1",
      "title": "Art. 1",
      "content": "W ustawie z dnia 20 stycznia 1990 r. o zmianach w organizacji i działalności spółdzielczości w art. 19a wyraz „sprzedana” zastępuje się wyrazami „zbyta bądź obciążona” ."
    },
    {
      "provision_ref": "art2",
      "section": "2",
      "title": "Art. 2",
      "content": "Ustawa wchodzi w życie po upływie 14 dni od dnia ogłoszenia."
    }
  ],
