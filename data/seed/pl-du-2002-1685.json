{
  "id": "pl-du-2002-1685",
  "type": "statute",
  "title": "Ustawa z dnia 30 października 2002 r. o zmianie ustawy o finansach publicznych.",
  "title_en": "",
  "short_name": "pl-du-2002-1685",
  "status": "repealed",
  "issued_date": "2002-10-30",
  "in_force_date": "2002-11-30",
  "url": "https://api.sejm.gov.pl/eli/acts/DU/2002/1685",
  "provisions": [
    {
      "provision_ref": "art1",
      "section": "1",
      "title": "Art. 1",
      "content": "W ustawie z dnia 26 listopada 1998 r. o finansach publicznych w art. 190 w ust. 1 zdanie wstępne otrzymuje brzmienie: „ Nie dłużej niż do dnia 31 grudnia 2004 r. dla obsługi budżetu państwa są prowadzone następujące rachunki bankowe: ” ."
    },
    {
      "provision_ref": "art2",
      "section": "2",
      "title": "Art. 2",
      "content": "Ustawa wchodzi w życie z dniem 31 grudnia 2002 r."
    }
  ],
