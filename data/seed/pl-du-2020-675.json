  "id": "pl-du-2020-675",
  "type": "statute",
  "title": "Rozporządzenie Rady Ministrów z dnia 7 kwietnia 2020 r. zmieniające rozporządzenie w sprawie zakazu stosowania materiału siewnego odmian kukurydzy MON 810",
  "title_en": "",
  "short_name": "pl-du-2020-675",
  "status": "in_force",
  "issued_date": "2020-04-07",
  "in_force_date": "2020-04-16",
  "url": "https://api.sejm.gov.pl/eli/acts/DU/2020/675",
  "provisions": [
    {
      "provision_ref": "par1",
      "section": "1",
      "title": "§ 1",
      "content": "W rozporządzeniu Rady Ministrów z dnia 2 stycznia 2013 r. w sprawie zakazu stosowania materiału siewnego odmian kukurydzy MON 810 załącznik do rozporządzenia otrzymuje brzmienie określone w załączniku do niniejszego rozporządzenia."
    },
    {
      "provision_ref": "par2",
      "section": "2",
      "title": "§ 2",
      "content": "Rozporządzenie wchodzi w życie z dniem następującym po dniu ogłoszenia."
    }
  ],
