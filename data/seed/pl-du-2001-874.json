{
  "id": "pl-du-2001-874",
  "type": "statute",
  "title": "Ustawa z dnia 21 czerwca 2001 r. o zmianie ustawy o Państwowej Straży Pożarnej.",
  "title_en": "",
  "short_name": "pl-du-2001-874",
  "status": "amended",
  "issued_date": "2001-06-21",
  "in_force_date": "2001-08-07",
  "url": "https://api.sejm.gov.pl/eli/acts/DU/2001/874",
  "provisions": [
    {
      "provision_ref": "art1",
      "section": "1",
      "title": "Art. 1",
      "content": "W ustawie z dnia 24 sierpnia 1991 r. o Państwowej Straży Pożarnej art. 19c otrzymuje brzmienie: „ Wykonywanie zadań zleconych szkołom Państwowej Straży Pożarnej przez osoby prawne lub fizyczne wykraczających poza zakres ustawowych zadań jest finansowane przez właściwego zleceniodawcę na podstawie zawartej umowy, a środki finansowe uzyskane z tego tytułu stanowią środki specjalne jednostki przeznaczone na cele statutowe szkół. ”"
    },
    {
      "provision_ref": "art2",
      "section": "2",
      "title": "Art. 2",
      "content": "Ustawa wchodzi w życie po upływie 30 dni od dnia ogłoszenia."
    }
  ],
