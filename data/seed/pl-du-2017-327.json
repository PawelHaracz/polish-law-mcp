  "id": "pl-du-2017-327",
  "type": "statute",
  "title": "Rozporządzenie Ministra Rolnictwa i Rozwoju Wsi z dnia 2 lutego 2017 r. w sprawie cech charakterystycznych odmiany roślin sadowniczych wpisywanej na sadowniczą listę B",
  "title_en": "",
  "short_name": "pl-du-2017-327",
  "status": "in_force",
  "issued_date": "2017-02-02",
  "in_force_date": "2017-02-23",
  "url": "https://api.sejm.gov.pl/eli/acts/DU/2017/327",
  "provisions": [
    {
      "provision_ref": "par1",
      "section": "1",
      "title": "§ 1",
      "content": "Cechy charakterystyczne odmiany roślin sadowniczych zawarte w opisie odmiany wpisywanej na sadowniczą listę B określa załącznik do rozporządzenia."
    },
    {
      "provision_ref": "par2",
      "section": "2",
      "title": "§ 2",
      "content": "Rozporządzenie wchodzi w życie po upływie 14 dni od dnia ogłoszenia."
    }
  ],
