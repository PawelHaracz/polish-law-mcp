{
  "id": "pl-du-1997-435",
  "type": "statute",
  "title": "Ustawa z dnia 10 kwietnia 1997 r. o zmianie ustawy o gospodarce gruntami i wywłaszczaniu nieruchomości.",
  "title_en": "",
  "short_name": "pl-du-1997-435",
  "status": "repealed",
  "issued_date": "1997-04-10",
  "in_force_date": "1997-06-30",
  "url": "https://api.sejm.gov.pl/eli/acts/DU/1997/435",
  "provisions": [
    {
      "provision_ref": "art1",
      "section": "1",
      "title": "Art. 1",
      "content": "W ustawie z dnia 29 kwietnia 1985 r. o gospodarce gruntami i wywłaszczaniu nieruchomości w art. 81 w ust. 5 skreśla się wyrazy „złożony nie później niż do dnia 31 grudnia 1992 r. W razie niezgłoszenia wniosku w tym terminie, uprawnienia wynikające z ust. 1 wygasają.”"
    },
    {
      "provision_ref": "art2",
      "section": "2",
      "title": "Art. 2",
      "content": "Ustawa wchodzi w życie po upływie 14 dni od dnia ogłoszenia."
    }
  ],
