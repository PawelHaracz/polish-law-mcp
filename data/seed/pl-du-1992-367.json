  "provisions": [
    {
      "provision_ref": "art1",
      "section": "1",
      "title": "Art. 1",
      "content": "W Konstytucji Rzeczypospolitej Polskiej w art. 32f w ust. 1 pkt 9 otrzymuje brzmienie: „ nadaje ordery i odznaczenia, ” ."
    },
    {
      "provision_ref": "art2",
      "section": "2",
      "title": "Art. 2",
      "content": "Ustawa wchodzi w życie po upływie 14 dni od dnia ogłoszenia."
    }
