  "type": "statute",
  "title": "Rozporządzenie Ministra Finansów z dnia 22 grudnia 2024 r. zmieniające rozporządzenie w sprawie obniżonych stawek podatku od towarów i usług",
  "title_en": "",
  "short_name": "pl-du-2024-1944",
  "status": "in_force",
  "issued_date": "2024-12-22",
  "in_force_date": "2024-12-27",
  "url": "https://api.sejm.gov.pl/eli/acts/DU/2024/1944",
  "provisions": [
    {
      "provision_ref": "par1",
      "section": "1",
      "title": "§ 1",
      "content": "W rozporządzeniu Ministra Finansów z dnia 9 grudnia 2023 r. w sprawie obniżonych stawek podatku od towarów i usług w § 11 w ust. 1 we wprowadzeniu do wyliczenia wyrazy „31 grudnia 2024 r.” zastępuje się wyrazami „31 marca 2025 r.” ."
    },
    {
      "provision_ref": "par2",
      "section": "2",
      "title": "§ 2",
      "content": "Rozporządzenie wchodzi w życie z dniem 31 grudnia 2024 r."
    }
  ],
