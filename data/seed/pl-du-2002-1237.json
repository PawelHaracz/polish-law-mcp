{
  "id": "pl-du-2002-1237",
  "type": "statute",
  "title": "Ustawa z dnia 24 lipca 2002 r. o zmianie ustawy o służbie cywilnej.",
  "title_en": "",
  "short_name": "pl-du-2002-1237",
  "status": "repealed",
  "issued_date": "2002-07-24",
  "in_force_date": "2002-09-16",
