{
  "id": "pl-du-2023-627",
  "type": "statute",
  "title": "Rozporządzenie Ministra Finansów z dnia 29 marca 2023 r. zmieniające rozporządzenie w sprawie dokumentacji cen transferowych w zakresie podatku dochodowego od osób fizycznych",
  "title_en": "",
  "short_name": "pl-du-2023-627",
  "status": "in_force",
  "issued_date": "2023-03-29",
  "in_force_date": "2023-04-03",
  "url": "https://api.sejm.gov.pl/eli/acts/DU/2023/627",
  "provisions": [
    {
      "provision_ref": "par1",
      "section": "1",
      "title": "§ 1",
      "content": "W rozporządzeniu Ministra Finansów z dnia 21 grudnia 2018 r. w sprawie dokumentacji cen transferowych w zakresie podatku dochodowego od osób fizycznych w § 2 w pkt 5 w lit. a skreśla się wyrazy „lub 1a” ."
    },
    {
      "provision_ref": "par2",
      "section": "2",
      "title": "§ 2",
      "content": "Rozporządzenie wchodzi w życie z dniem ogłoszenia, z mocą od dnia 1 stycznia 2021 r."
    }
  ],
