{
  "id": "pl-du-1997-1042",
  "type": "statute",
  "title": "Ustawa z dnia 4 grudnia 1997 r. o zmianie ustawy - Prawo budżetowe i ustawy - Prawo energetyczne.",
  "title_en": "",
  "short_name": "pl-du-1997-1042",
  "status": "in_force",
  "issued_date": "1997-12-04",
  "in_force_date": "1997-12-24",
  "url": "https://api.sejm.gov.pl/eli/acts/DU/1997/1042",
  "provisions": [
    {
      "provision_ref": "art1",
      "section": "1",
      "title": "Art. 1",
      "content": "W ustawie z dnia 5 stycznia 1991 r. - Prawo budżetowe w art. 31 w ust. 3 w pkt 2 po wyrazach „Krajowej Rady Radiofonii i Telewizji” , skreśla się wyrazy „Urzędu Regulacji Energetyki,” ."
    },
    {
      "provision_ref": "art2",
      "section": "2",
      "title": "Art. 2",
      "content": "W ustawie z dnia 10 kwietnia 1997 r. - Prawo energetyczne w art. 72 skreśla się kropkę i dodaje się wyrazy „oraz art. 18 ust. 3 i 4, który wchodzi w życie z dniem 1 stycznia 1999 r.”"
    },
    {
      "provision_ref": "art3",
      "section": "3",
      "title": "Art. 3",
      "content": "Ustawa wchodzi w życie z dniem ogłoszenia z mocą od dnia 5 grudnia 1997 r."
    }
  ],
