{
  "id": "pl-du-1998-383",
  "type": "statute",
  "title": "Ustawa z dnia 2 kwietnia 1998 r. o zmianie ustawy o podatku dochodowym od osób prawnych.",
  "title_en": "",
  "short_name": "pl-du-1998-383",
  "status": "amended",
  "issued_date": "1998-04-02",
  "in_force_date": "1998-05-16",
  "url": "https://api.sejm.gov.pl/eli/acts/DU/1998/383",
  "provisions": [
    {
      "provision_ref": "art1",
      "section": "1",
      "title": "Art. 1",
      "content": "W ustawie z dnia 15 lutego 1992 r. o podatku dochodowym od osób prawnych w art. 17 w ust. 1 w pkt 6 po wyrazach „społeczno-zawodowych organizacji rolników” dodaje się wyrazy „izb rolniczych” ."
    },
    {
      "provision_ref": "art2",
      "section": "2",
      "title": "Art. 2",
      "content": "Ustawa wchodzi w życie po upływie 14 dni od dnia ogłoszenia i ma zastosowanie do dochodów uzyskanych od dnia 1 stycznia 1998 r."
    }
  ],
